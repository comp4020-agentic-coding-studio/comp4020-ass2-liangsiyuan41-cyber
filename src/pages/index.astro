---
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import BaseLayout from "astro-theme-university/layouts/BaseLayout.astro";
import { courseMeta } from "../course-config";
import { siteConfig } from "../site-config";

const stages = [
  {
    number: "01",
    name: "See the Shot",
    text: "Rules, aiming, contact, and cue-ball movement.",
  },
  {
    number: "02",
    name: "Control the Shot",
    text: "Stop, follow, draw, spin, rails, and positional control.",
  },
  {
    number: "03",
    name: "Think Beyond the Shot",
    text: "Position play, three-shot planning, safety, table reading, and match strategy.",
  },
];
---

<BaseLayout title={`${courseMeta.code}: ${courseMeta.title}`} description={courseMeta.description} {...siteConfig}>
  <section class="pool-hero" slot="hero" aria-label="Course introduction">
    <div class="pool-hero__inner">
      <div class="pool-hero__copy">
        <p class="pool-hero__code">{courseMeta.code}</p>
        <h1 class="pool-hero__title">{courseMeta.title}</h1>
        <p class="pool-hero__tagline">Every shot should prepare the next one.</p>
        <p class="pool-hero__intro">{courseMeta.description}</p>
        <ul class="course-tags" aria-label="Course tags">
          {courseMeta.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>

      <svg
        class="pool-hero__diagram"
        viewBox="0 0 480 320"
        role="img"
        aria-label="Diagram of a pool table showing a three-shot trajectory: the cue ball to a first object ball, on to a second, and finally into a corner pocket"
      >
        <rect x="16" y="16" width="448" height="288" rx="16" fill="#123f30" stroke="#c9a24a" stroke-width="2" />

        {/* Pockets */}
        <circle cx="16" cy="16" r="9" fill="#08251c" stroke="#c9a24a" stroke-width="1" />
        <circle cx="464" cy="16" r="9" fill="#08251c" stroke="#c9a24a" stroke-width="1" />
        <circle cx="16" cy="304" r="9" fill="#08251c" stroke="#c9a24a" stroke-width="1" />
        <circle cx="464" cy="304" r="9" fill="#08251c" stroke="#c9a24a" stroke-width="1" />
        <circle cx="240" cy="16" r="9" fill="#08251c" stroke="#c9a24a" stroke-width="1" />
        <circle cx="240" cy="304" r="9" fill="#08251c" stroke="#c9a24a" stroke-width="1" />

        {/* Shot trajectory: cue ball -> ball A -> ball B -> pocket */}
        <line x1="90" y1="250" x2="220" y2="190" stroke="#c9a24a" stroke-width="2.5" />
        <line x1="220" y1="190" x2="340" y2="120" stroke="#c9a24a" stroke-width="2" stroke-dasharray="6 4" opacity="0.85" />
        <line x1="340" y1="120" x2="464" y2="16" stroke="#c9a24a" stroke-width="1.5" stroke-dasharray="2 4" opacity="0.7" />

        {/* Balls */}
        <circle cx="90" cy="250" r="9" fill="#f2ead9" stroke="#0b3a2a" stroke-width="1" />
        <circle cx="220" cy="190" r="9" fill="#c9a24a" stroke="#0b3a2a" stroke-width="1" />
        <circle cx="340" cy="120" r="9" fill="none" stroke="#c9a24a" stroke-width="1.5" stroke-dasharray="2 3" />

        {/* Step badges */}
        <circle cx="155" cy="220" r="10" fill="#08251c" stroke="#c9a24a" stroke-width="1.5" />
        <text x="155" y="224" fill="#f2ead9" font-size="11" font-weight="600" text-anchor="middle">1</text>
        <circle cx="280" cy="155" r="10" fill="#08251c" stroke="#c9a24a" stroke-width="1.5" />
        <text x="280" y="159" fill="#f2ead9" font-size="11" font-weight="600" text-anchor="middle">2</text>
        <circle cx="402" cy="68" r="10" fill="#08251c" stroke="#c9a24a" stroke-width="1.5" />
        <text x="402" y="72" fill="#f2ead9" font-size="11" font-weight="600" text-anchor="middle">3</text>
      </svg>
    </div>
  </section>

  <section class="stage-progression" aria-labelledby="stage-progression-heading">
    <h2 id="stage-progression-heading">Three stages, one progression</h2>
    <ol class="stage-progression__list">
      {
        stages.map((stage) => (
          <li class="stage-progression__item">
            <span class="stage-progression__number" aria-hidden="true">{stage.number}</span>
            <h3 class="stage-progression__name">{stage.name}</h3>
            <p class="stage-progression__text">{stage.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section aria-labelledby="where-next-heading">
    <h2 id="where-next-heading">Where to go next</h2>
    <CardGrid columns={2}>
      <Card title="Course Overview" href="/overview/">
        <p>Learning philosophy, intended audience, and the shape of the semester.</p>
      </Card>
      <Card title="Weeks" href="/sessions/">
        <p>The 12-week teaching schedule and what each week covers.</p>
      </Card>
      <Card title="Assessments" href="/assessments/">
        <p>What is marked, what it is worth, and when it is due.</p>
      </Card>
      <Card title="Resources" href="/resources/">
        <p>Slides, diagrams, drills, and terminology as they're published.</p>
      </Card>
    </CardGrid>
  </section>
</BaseLayout>

<style>
  .pool-hero {
    grid-column: full;
    background:
      radial-gradient(ellipse at 30% 20%, #123f30 0%, #08251c 65%),
      #08251c;
    border-block-end: 1px solid var(--at-border);
  }

  .pool-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    align-items: center;
    gap: var(--at-spacing-2xl);
    max-inline-size: calc(var(--at-content-width) + 2 * var(--at-content-inset) + 26rem);
    margin-inline: auto;
    padding: var(--at-spacing-2xl) var(--at-content-inset);
  }

  .pool-hero__code {
    margin: 0 0 var(--at-spacing-sm);
    color: var(--at-secondary);
    font-size: var(--at-font-size-sm);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pool-hero__title {
    margin: 0 0 var(--at-spacing-md);
    color: #f2ead9;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .pool-hero__tagline {
    margin: 0 0 var(--at-spacing-lg);
    color: var(--at-secondary);
    font-size: var(--at-font-size-h4);
    font-style: italic;
  }

  .pool-hero__intro {
    margin: 0;
    max-inline-size: 42ch;
    color: rgb(242 234 217 / 82%);
  }

  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: var(--at-spacing-lg) 0;
    padding: 0;
    list-style: none;
  }

  .course-tags li {
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--at-border);
    border-radius: 999px;
    color: #f2ead9;
    background: rgb(242 234 217 / 6%);
    font-size: 0.85rem;
  }

  .pool-hero__diagram {
    inline-size: 100%;
    block-size: auto;
  }

  @media (width < 900px) {
    .pool-hero__inner {
      grid-template-columns: 1fr;
    }

    .pool-hero__diagram {
      max-inline-size: 24rem;
      margin-inline: auto;
    }
  }

  .stage-progression__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--at-spacing-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stage-progression__item {
    padding: var(--at-spacing-lg);
    border: 1px solid var(--at-divider);
    border-radius: var(--at-border-radius);
    background: var(--at-bg-alt);
  }

  .stage-progression__number {
    display: block;
    margin-block-end: var(--at-spacing-sm);
    color: var(--at-secondary);
    font-size: var(--at-font-size-sm);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .stage-progression__name {
    margin: 0 0 var(--at-spacing-sm);
  }

  .stage-progression__text {
    margin: 0;
    color: var(--at-text-secondary);
  }

  @media (width < 640px) {
    .stage-progression__list {
      grid-template-columns: 1fr;
    }
  }
</style>
